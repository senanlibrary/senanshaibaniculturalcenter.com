---
interface Props {
  src: string;
  /** Describes the image for readers who cannot see it. Required. */
  alt: string;
  caption?: string;
  /** Small print after the caption: provenance, date, holding library. */
  credit?: string;
  /**
   * Objects photographed in their own proportions -- a portrait, a book
   * cover -- rather than scene photographs, which are all delivered at the
   * same 3:2 landscape frame.
   */
  portrait?: boolean;
  /** Fills the page shell. Reserved for the one lead image on a page. */
  hero?: boolean;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  caption,
  credit,
  portrait = false,
  hero = false,
  width,
  height,
  loading = 'lazy',
} = Astro.props;
---

<figure class={['fig', portrait && 'fig--portrait', hero && 'fig--hero'].filter(Boolean).join(' ')}>
  <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {credit && <span class="credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  /* One image per page, sized to sit inside the reading column rather than
     dominate it. Scene photographs share a single 3:2 frame so that pages
     feel consistent as you move between them. */
  .fig {
    margin: 2.75rem 0;
    max-width: var(--measure);
  }

  /* The lead image on a page runs the full width of the shell; anything
     narrower reads as an afterthought rather than an establishing view. */
  .fig--hero {
    max-width: none;
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
  }

  .fig--portrait {
    max-width: 18rem;
  }

  .fig img {
    width: 100%;
    height: auto;
    display: block;
    background: var(--paper-sunk);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .credit {
    display: block;
    margin-top: 0.25rem;
    opacity: 0.85;
  }
</style>
