---
import { readRedirects } from '../lib/redirects.mjs';
import { url } from '../lib/paths';

/**
 * Builds one small forwarding page per entry in src/redirects.txt, so every
 * URL the old WordPress site published still leads somewhere.
 *
 * GitHub Pages serves static files only and cannot issue a real 301, so each
 * page forwards three ways: a canonical link telling search engines where the
 * content actually lives, a meta refresh, and a plain link for anyone whose
 * browser does neither.
 */
export function getStaticPaths() {
  return readRedirects().map(({ from, to }) => ({
    // Astro wants the path without surrounding slashes.
    params: { redirect: from.replace(/^\/|\/$/g, '') },
    props: { to },
  }));
}

const { to } = Astro.props;
const target = url(to);
const canonical = new URL(to, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved — Senan Shaibani Cultural Center</title>
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <style>
      body {
        font-family: 'Iowan Old Style', Palatino, Georgia, serif;
        background: #faf8f3;
        color: #1a1815;
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        text-align: center;
        padding: 2rem;
        line-height: 1.6;
      }
      a { color: #7b3f2e; }
    </style>
  </head>
  <body>
    <p>This page has moved.</p>
    <p><a href={target}>Continue to its new address</a></p>
  </body>
</html>
